MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/rana-forwarder
JWT_SECRET=replace-with-a-long-random-secret

# DEV ONLY: set to "true" to skip the admin login check entirely (no DB/password
# lookup) — useful when working locally and the database is unreachable. Only
# ever takes effect when NODE_ENV !== "production", so it's inert on Vercel
# regardless of this value. Leave unset/false normally.
DEV_SKIP_AUTH=false

# Enquiry email notifications (contact + quote form submissions).
# GMAIL_USER needs 2-Step Verification enabled, with an App Password generated
# at https://myaccount.google.com/apppasswords (NOT the regular account password).
GMAIL_USER=rana.forwarders@gmail.com
GMAIL_APP_PASSWORD=replace-with-a-16-character-app-password
# Optional — defaults to GMAIL_USER if unset. Set this if you want notifications
# sent to a different inbox than the one that sends them.
NOTIFY_EMAIL=

# Carrier live-tracking APIs (optional — only needed to sync shipments whose
# carrier's "Live Tracking API" is set to Ship24/UPS/FedEx/DHL in /admin/carriers).
# Leave unset and syncing that provider will fail with a clear "not configured" error.

# Ship24 — a single key covers ~1200 couriers worldwide; the easiest provider to set up.
SHIP24_API_KEY=
SHIP24_API_BASE_URL=https://api.ship24.com/public/v1

UPS_CLIENT_ID=
UPS_CLIENT_SECRET=
UPS_API_BASE_URL=https://onlinetools.ups.com

FEDEX_CLIENT_ID=
FEDEX_CLIENT_SECRET=
FEDEX_API_BASE_URL=https://apis.fedex.com

DHL_API_KEY=
DHL_API_BASE_URL=https://api-eu.dhl.com
